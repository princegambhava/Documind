# LLM Backend Configuration
# Choose which LLM backend to use: "gemini" or "groq"
LLM_BACKEND=gemini

# API Keys
# Get Gemini API key from: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here

# Get Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Model Names (optional - defaults are provided)
# Gemini models: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
GEMINI_MODEL=gemini-1.5-flash

# Groq models: openai/gpt-oss-20b, llama-3.1-8b-instant, llama-3.1-70b-instant, mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-20b

# API Timeouts (optional - defaults are 60 seconds)
GEMINI_TIMEOUT=60
GROQ_TIMEOUT=60
